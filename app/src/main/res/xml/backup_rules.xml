<?xml version="1.0" encoding="utf-8"?><!--
   Sample backup rules file; uncomment and customize as necessary.
   See https://developer.android.com/guide/topics/data/autobackup
   for details.
   Note: This file is ignored for devices older than API 31
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <!-- Household snapshots and medication alarm metadata stay on this
         device and are not copied to cloud backups. -->
    <exclude domain="sharedpref" path="." />
    <!-- Location history and outside-zone alerts are sensitive and remain
         local to the tracking phone. -->
    <exclude domain="database" path="one_outside_tracking.db" />
</full-backup-content>
